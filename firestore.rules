rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['rugvvedniichite@gmail.com','enterprisesashtavinayak71@gmail.com'];
    }
  }
}
